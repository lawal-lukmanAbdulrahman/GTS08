# Copy to .env (repo root), apps/web/.env.local and apps/dashboard/.env.local, then fill in the blanks.
# NEXT_PUBLIC_ values are visible in the browser: never put a secret in one.
# Marked SECRET = server only. Never commit a filled-in copy.

# ── Supabase ────────────────────────────────────────────────────────────────
# Hosted project: https://<project-ref>.supabase.co   Local (`supabase start`): http://localhost:54321
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET. Bypasses row-level security, so it must only ever run on the server.
SUPABASE_SERVICE_ROLE_KEY=

# ── App URLs ────────────────────────────────────────────────────────────────
# Used in emails and the Paystack return page. Use the real deployed URLs in staging and production.
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3002
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3001
# Dashboard app only: where it finds the API (the web app's address, no trailing slash).
NEXT_PUBLIC_API_URL=http://localhost:3002

# ── Cloudinary (product images) ─────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Name of the upload preset (defaults to gtsProducts if left out).
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=gtsProducts
# SECRET. Rotate it if it was ever committed.
CLOUDINARY_API_KEY=

# ── Paystack (online payments) ──────────────────────────────────────────────
# SECRET. Use sk_test_... locally and on staging, sk_live_... only in production.
# Without it, online checkout is refused and the payment webhook won't run.
PAYSTACK_SECRET_KEY=

# ── Resend (email) ──────────────────────────────────────────────────────────
# SECRET.
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "GTS Wears <hello@gts.ng>". Without both keys, email is skipped (never an error).
# No domain yet? "GTS <onboarding@resend.dev>" works for testing, but Resend only delivers it to the email address of your own Resend account.
# Check the setup any time in the dashboard: Settings > Email > "Send a test email to me".
EMAIL_FROM=
# Optional: reply-to address, and the unsubscribe contact printed in campaign emails.
EMAIL_REPLY_TO=

# ── Scheduled jobs ──────────────────────────────────────────────────────────
# SECRET. Vercel Cron sends it as a bearer token. The jobs (expire unpaid orders, release stock holds,
# send scheduled campaigns) refuse to run without it. Generate one: openssl rand -base64 32
CRON_SECRET=
# Unpaid orders are cancelled and their stock released after:
WHATSAPP_ORDER_EXPIRY_HOURS=24
ONLINE_ORDER_EXPIRY_MINUTES=60

# ── Optional ────────────────────────────────────────────────────────────────
# Rate limits shared across servers (without these, each server counts on its own).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Phone-code SMS (Termii).
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=https://v4.api.termii.com
# Development only. Leave unset in staging and production.
ENABLE_DEV_ADMIN_BYPASS=

# ── Scripts and tests only (not read by the running apps) ───────────────────
# Direct Postgres connection string, for maintenance scripts.
SUPABASE_DB_URL=
# scripts/qa/api-e2e.cjs signs in as this admin; never commit real values.
QA_ADMIN_EMAIL=
QA_ADMIN_PASSWORD=
QA_API_BASE=http://localhost:3002/api/v1
# Playwright flows (pnpm test:e2e).
E2E_API_URL=http://localhost:3002
E2E_DASHBOARD_URL=http://localhost:3001
